# Local development defaults. Keep real credentials in .env, never in source control.
INVOICE_BIND=127.0.0.1:3030
INVOICE_ORIGIN=http://localhost:3030
INVOICE_DATA_DIR=data
INVOICE_DEMO=0
# Optional local path to your sample PDF directory. Not required for normal use.
# INVOICE_SAMPLE_DIR=/absolute/path/to/invoices

# Operator creates these OAuth applications once. Store owners use provider sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Account email (verification and password reset). Leave these unset in local development: the
# app then works without email and nobody can verify or recover an address. A public deployment
# refuses to start without a mail backend. Choose ONE:
#
#   Resend (HTTPS API; works where outbound SMTP is blocked, such as Railway's lower plans).
#   Verify a sending subdomain in Resend first, then create a sending-only API key.
# RESEND_API_KEY=
#
#   or SMTP: smtps://user:pass@host:465 or smtp://user:pass@host:587?tls=required
#   (plaintext SMTP is accepted only to loopback).
# SMTP_URL=
#
# The sender; its domain must be verified with the provider.
# MAIL_FROM="SumLine <no-reply@mail.your-domain.example>"
# Where replies go (the sender is a no-reply address). Defaults to INVOICE_PRIVACY_EMAIL.
# MAIL_REPLY_TO=support@your-domain.example
#
# Prove the setup works:  sumline --test-email you@example.com

# Who runs this deployment, as named in the privacy policy (/privacy) and terms (/terms). A
# public deployment will not start until the first six are set; make each one true. Locally the
# pages show "[not set: ...]" markers.
# Values with spaces must be in double quotes in this file (Railway's Variables tab takes them
# as they are).
# INVOICE_OPERATOR_NAME="Full Name and Other Name"
# INVOICE_OPERATOR_ADDRESS=
# INVOICE_PRIVACY_EMAIL=
# INVOICE_GOVERNING_LAW="British Columbia"
# INVOICE_HOSTING_PROVIDER=Railway
# INVOICE_HOSTING_REGION="United States (California)"
# INVOICE_BACKUP_RETENTION="90 days"

# Registration gate for a pilot: people must enter this phrase (workspace invitations are
# exempt). A public deployment refuses to start without it unless INVOICE_ALLOW_OPEN_SIGNUP=1.
# INVOICE_SIGNUP_CODE=

# The encryption key for documents and mailbox tokens, from `sumline --generate-key`.
# Keep it in the host's secret variables, never beside the database. A public deployment never
# creates one itself; locally an encryption.key file is created in the data directory.
# INVOICE_ENCRYPTION_KEY=

# Set when a reverse proxy you run (Caddy, nginx, Railway's edge) forwards requests, so sign-in
# rate limits count real visitors instead of the proxy. Comma-separated proxy addresses, ranges
# (10.0.0.0/8) or the word "private". On Railway use: private,100.0.0.0/8. Never list a range
# that includes the public internet.
# INVOICE_TRUSTED_PROXY=127.0.0.1

# Seconds between checks of each connected mailbox (60 to 3600). Gmail checks are cheap when
# nothing has arrived, so shortening this costs little.
# INVOICE_POLL_SECONDS=300

# Bounded extraction concurrency: 1 to 8. One application process per data directory.
INVOICE_WORKERS=2
# Initial mailbox scan only; subsequent scans use the saved checkpoint.
INVOICE_INITIAL_LOOKBACK_DAYS=30
# Optional private file containing exactly 32 bytes, mounted separately from the database.
# INVOICE_ENCRYPTION_KEY_FILE=/run/secrets/invoice-encryption-key
# Optional private environment file. Missing explicitly configured files stop startup.
# INVOICE_CONFIG_FILE=/private/path/config.env
