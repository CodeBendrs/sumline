# Local development defaults. Keep real credentials in .env, never in source control.
INVOICE_BIND=127.0.0.1:3030
INVOICE_ORIGIN=http://localhost:3030
INVOICE_DATA_DIR=data
INVOICE_DEMO=0
# Optional local path to your sample PDF directory. Not required for normal use.
# INVOICE_SAMPLE_DIR=/absolute/path/to/invoices

# Operator creates these OAuth applications once. Store owners use provider sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Bounded extraction concurrency: 1 to 8. One application process per data directory.
INVOICE_WORKERS=2
# Initial mailbox scan only; subsequent scans use the saved checkpoint.
INVOICE_INITIAL_LOOKBACK_DAYS=30
# Optional private file containing exactly 32 bytes, mounted separately from the database.
# INVOICE_ENCRYPTION_KEY_FILE=/run/secrets/invoice-encryption-key
# Optional private environment file. Missing explicitly configured files stop startup.
# INVOICE_CONFIG_FILE=/private/path/config.env
